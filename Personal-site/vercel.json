{
  "rewrites": [
    { "source": "/pages/video.html", "destination": "/api/video-page" },
    { "source": "/pages/photo.html", "destination": "/api/photo-page" },
    { "source": "/pages/clients.html", "destination": "/api/client-page" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "my-portfolio.vercel.app" }],
      "destination": "https://www.xaviflores.com/:path*",
      "permanent": true
    }
  ]
}
